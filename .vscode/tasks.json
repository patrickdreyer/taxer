{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tox",
      "detail": "Runs all tests and linting using tox.",
      "type": "shell",
      "command": "tox",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "args": [],
      "isBackground": false,
      "options": {"cwd": "${workspaceFolder}"}
    },
    {
      "label": "Doc: Serve",
      "detail": "Runs the live-reloading MkDocs server at http://localhost:8000.",
      "type": "shell",
      "command": "mkdocs serve --dev-addr 0.0.0.0:8000",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": [],
    },
    {
      "label": "Doc: Build",
      "detail": "Builds the static HTML site into the ./site directory.",
      "type": "shell",
      "command": "mkdocs build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
    }
  ]
}